{
  "name": "esperia",
  "private": true,
  "version": "0.1.0",
  "description": "Esperia — piattaforma editoriale digitale (portale news, community, backoffice, modulo AI)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:cms": "turbo run dev --filter=@esperia/cms",
    "dev:portal": "turbo run dev --filter=@esperia/portal",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  }
}
