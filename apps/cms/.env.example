# --- Database ------------------------------------------------------------
# Postgres di Supabase. Usare la connection string "Session pooler" (porta 5432)
# perche' Payload/Drizzle ha bisogno di prepared statements e advisory lock.
DATABASE_URI=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Payload -------------------------------------------------------------
# openssl rand -base64 32
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# --- Portale (per anteprima e invalidazione cache) -----------------------
PORTAL_URL=http://localhost:4321
PORTAL_REVALIDATE_SECRET=

# --- Supabase (community: moderazione lato backoffice) -------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage media (S3-compatible: Supabase Storage, R2, MinIO...) -------
S3_BUCKET=esperia-media
S3_REGION=eu-central-1
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://<ref>.storage.supabase.co/storage/v1/object/public/esperia-media

# --- AI ------------------------------------------------------------------
# Fallback: se non impostate qui, le chiavi si configurano da backoffice
# (Impostazioni AI, solo Amministratore) — RF-AI-09.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
