# --- CMS ------------------------------------------------------------------
# URL del backoffice Payload da cui il portale legge i contenuti.
PAYLOAD_URL=http://localhost:3001

# Segreto condiviso con il CMS: autentica le chiamate di invalidazione cache
# e di anteprima. Deve coincidere con PORTAL_REVALIDATE_SECRET lato CMS.
PORTAL_REVALIDATE_SECRET=

# --- Sito -----------------------------------------------------------------
# URL pubblico definitivo: serve a canonical, sitemap, feed RSS e Open Graph.
PUBLIC_SITE_URL=http://localhost:4321

# --- Supabase (community) -------------------------------------------------
# La chiave anon e' pubblica per definizione: la protezione e' data da RLS.
PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
