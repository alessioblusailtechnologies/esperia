---
import Base from '@/layouts/Base.astro'
import ArticleCard from '@/components/ArticleCard.astro'
import { getArticles, getCategories, getSiteSettings, CmsUnavailableError } from '@/lib/payload'
import { populated, populatedList } from '@/lib/types'
import type { Article, Category } from '@/lib/types'

/**
 * Homepage — RF-P-01. Impaginazione dai design (Home v1).
 *
 * Tre blocchi: articoli in evidenza (apertura + tre secondari), ultime notizie
 * in elenco, accessi rapidi alle categorie.
 */

const settings = await getSiteSettings()

let apertura: Article | null = null
let secondari: Article[] = []
let ultime: Article[] = []
let cmsOffline = false

try {
  // Priorità alla scelta editoriale: prima l'apertura manuale nelle impostazioni,
  // poi gli articoli marcati "in evidenza", infine i più recenti.
  const manuali = populatedList<Article>(settings.featuredArticles)
  const inEvidenza =
    manuali.length > 0 ? manuali : (await getArticles({ featured: true, limit: 4 })).docs

  const recenti = await getArticles({ limit: 20 })

  const selezione = inEvidenza.length > 0 ? inEvidenza : recenti.docs
  apertura = selezione[0] ?? null

  /*
   * L'apertura più tre secondari: è la composizione dei design. Se la redazione
   * ha marcato meno di quattro articoli in evidenza completiamo con i più
   * recenti, così la griglia non resta spaiata (con due sole schede occuperebbero
   * mezza pagina ciascuna).
   */
  const scelti = new Set([apertura?.id].filter(Boolean) as string[])
  secondari = selezione.slice(1, 4)
  for (const a of secondari) scelti.add(a.id)

  for (const a of recenti.docs) {
    if (secondari.length >= 3) break
    if (scelti.has(a.id)) continue
    secondari.push(a)
    scelti.add(a.id)
  }

  ultime = recenti.docs.filter((a) => !scelti.has(a.id)).slice(0, 8)
} catch (err) {
  if (err instanceof CmsUnavailableError) {
    cmsOffline = true
    console.error('[home] CMS non raggiungibile:', err.message)
  } else {
    throw err
  }
}

/*
 * Accessi rapidi: le sezioni configurate in backoffice, oppure — se non ne è
 * stata configurata nessuna — le prime quattro categorie del menu. Così la
 * home non ha mai un buco al primo avvio.
 */
let accessiRapidi: Array<{ categoria: Category; titolo: string; articoli: Article[] }> = []

if (!cmsOffline) {
  const configurate = settings.homeSections ?? []
  const daMostrare =
    configurate.length > 0
      ? configurate
          .map((s) => ({ categoria: populated<Category>(s.category), titolo: s.title, limit: 2 }))
          .filter((s): s is { categoria: Category; titolo: string | null | undefined; limit: number } =>
            Boolean(s.categoria),
          )
      : (await getCategories())
          .filter((c) => c.showInMenu !== false)
          .slice(0, 4)
          .map((categoria) => ({ categoria, titolo: null, limit: 2 }))

  accessiRapidi = (
    await Promise.all(
      daMostrare.map(async (s) => {
        try {
          const res = await getArticles({ categorySlug: s.categoria.slug, limit: s.limit })
          if (res.docs.length === 0) return null
          return {
            categoria: s.categoria,
            titolo: s.titolo || s.categoria.name,
            articoli: res.docs,
          }
        } catch {
          return null
        }
      }),
    )
  ).filter((s): s is { categoria: Category; titolo: string; articoli: Article[] } => s !== null)
}
---

<Base title={settings.siteName} description={settings.tagline}>
  {cmsOffline ? (
    <div class="avviso">
      <h1>Contenuti momentaneamente non disponibili</h1>
      <p>Stiamo riscontrando un problema tecnico. Riprova fra qualche minuto.</p>
    </div>
  ) : (
    <>
      {apertura && (
        <section class="blocco blocco--evidenza" aria-labelledby="t-evidenza">
          <h1 id="t-evidenza" class="filo-sezione eyebrow">Articoli in evidenza</h1>

          <ArticleCard article={apertura} variante="apertura" prioritaria livelloTitolo={2} />

          {secondari.length > 0 && (
            <div class="griglia-secondari">
              {secondari.map((a) => <ArticleCard article={a} livelloTitolo={3} />)}
            </div>
          )}
        </section>
      )}

      {ultime.length > 0 && (
        <section class="blocco" aria-labelledby="t-ultime">
          <h2 id="t-ultime" class="filo-sezione eyebrow">Ultime notizie</h2>

          <div class="elenco-ultime">
            {ultime.map((a) => (
              <ArticleCard article={a} variante="riga" livelloTitolo={3} mostraOra />
            ))}
          </div>

          <p class="blocco__archivio">
            <a href="/archivio">Tutte le notizie in archivio →</a>
          </p>
        </section>
      )}

      {accessiRapidi.length > 0 && (
        <section class="pannello" aria-labelledby="t-accessi">
          <h2 id="t-accessi" class="eyebrow pannello__titolo">Accessi rapidi alle categorie</h2>

          <div class="pannello__griglia">
            {accessiRapidi.map((s) => (
              <div class="accesso">
                <h3 class="accesso__titolo">
                  <a href={`/categoria/${s.categoria.slug}`}>
                    {s.titolo} <span aria-hidden="true">→</span>
                  </a>
                </h3>
                <div class="accesso__filo"></div>
                <ul class="accesso__voci">
                  {s.articoli.map((a) => (
                    <li><a href={`/${a.slug}`}>{a.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</Base>

<style>
  .blocco {
    padding: clamp(22px, 3vw, 34px) var(--padding-laterale) 0;
  }

  .blocco--evidenza {
    padding-bottom: 0;
  }

  .griglia-secondari {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(20px, 2.4vw, 30px);
    padding: clamp(28px, 3vw, 40px) 0 clamp(30px, 4vw, 48px);
  }

  .elenco-ultime {
    display: flex;
    flex-direction: column;
  }

  /* L'ultima riga dell'elenco non ha bisogno del filo: sotto c'è già il link
     all'archivio, e due separatori affiancati sono rumore. */
  .elenco-ultime > :global(.scheda--riga:last-child) {
    border-bottom: 0;
  }

  .blocco__archivio {
    padding-top: 20px;
  }

  .blocco__archivio a {
    font-size: 13px;
    font-weight: var(--peso-medio);
    color: var(--colore-accento);
    border-bottom: 1px solid var(--colore-accento);
    padding-bottom: 2px;
  }

  .blocco__archivio a:hover {
    color: var(--colore-accento-scuro);
    border-bottom-color: var(--colore-accento-scuro);
  }

  .pannello {
    margin: clamp(30px, 4vw, 46px) var(--padding-laterale) 0;
    background: var(--colore-superficie);
    border-radius: var(--raggio-lg);
    padding: clamp(22px, 3vw, 34px);
  }

  .pannello__titolo {
    padding-bottom: var(--spazio-6);
  }

  .pannello__griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(18px, 2vw, 26px);
  }

  .accesso {
    display: flex;
    flex-direction: column;
    gap: var(--spazio-4);
  }

  .accesso__titolo {
    font-family: var(--font-titoli);
    font-size: 20px;
    font-weight: var(--peso-forte);
    line-height: 1.2;
  }

  .accesso__titolo span {
    font-size: 14px;
    color: var(--colore-accento);
  }

  .accesso__filo {
    height: 1px;
    background: var(--colore-bordo-medio);
  }

  .accesso__voci {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spazio-4);
    font-size: var(--testo-base);
    line-height: 1.42;
    color: var(--colore-testo-tenue);
  }

  .avviso {
    padding: clamp(60px, 12vw, 140px) var(--padding-laterale);
    text-align: center;
  }

  .avviso h1 {
    font-size: var(--titolo-sezione);
    margin-bottom: var(--spazio-5);
  }

  .avviso p {
    color: var(--colore-testo-tenue);
  }
</style>
