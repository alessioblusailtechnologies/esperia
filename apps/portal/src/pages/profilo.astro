---
import Base from '@/layouts/Base.astro'
import AreaUtente from '@/components/AreaUtente.astro'
import Profilo from '@/components/islands/account/Profilo.tsx'
import { MOCK } from '@/lib/modalita'

/**
 * Profilo dell'utente — RF-C-02, RF-C-07.
 *
 * Senza sessione l'isola rimanda ad /accedi, che poi riporta qui.
 */
---

<Base title="Il tuo profilo" description="Profilo personale nell’area riservata di Esperia." noIndex>
  <AreaUtente titolo="Il tuo profilo">
    {
      MOCK ? (
        <p class="riquadro">
          Nella versione dimostrativa l’area riservata non è collegata: registrazione, accesso e
          profilo funzionano nel portale vero, con la community attiva.
        </p>
      ) : (
        <Profilo client:load />
      )
    }
  </AreaUtente>
</Base>
