---
import Base from '@/layouts/Base.astro'
import AreaUtente from '@/components/AreaUtente.astro'
import Accesso from '@/components/islands/account/Accesso.tsx'
import { MOCK } from '@/lib/modalita'

/**
 * Accesso alla community — RF-C-01.
 *
 * Il modulo e' un'isola: la sessione vive nel browser, gestita da Supabase
 * Auth. La pagina resta fuori dalla cache (middleware.ts).
 */
---

<Base title="Accedi" description="Accesso all’area riservata di Esperia." noIndex>
  <AreaUtente
    titolo="Accedi"
    sottotitolo="Entra con l’email e la password del tuo account per commentare gli articoli."
  >
    {
      MOCK ? (
        <p class="riquadro">
          Nella versione dimostrativa l’area riservata non è collegata: registrazione, accesso e
          profilo funzionano nel portale vero, con la community attiva.
        </p>
      ) : (
        <Accesso client:load />
      )
    }
  </AreaUtente>
</Base>
