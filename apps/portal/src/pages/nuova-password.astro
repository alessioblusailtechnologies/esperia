---
import Base from '@/layouts/Base.astro'
import AreaUtente from '@/components/AreaUtente.astro'
import NuovaPassword from '@/components/islands/account/NuovaPassword.tsx'
import { MOCK } from '@/lib/modalita'

/**
 * Destinazione del link di recupero password — RF-C-01.
 *
 * L'indirizzo va aggiunto fra gli URL di reindirizzamento ammessi nel
 * progetto Supabase, altrimenti il link dell'email porta alla home.
 */
---

<Base title="Nuova password" description="Reimpostazione della password dell’area riservata." noIndex>
  <AreaUtente
    titolo="Nuova password"
    sottotitolo="Scegli la nuova password per il tuo account."
  >
    {
      MOCK ? (
        <p class="riquadro">
          Nella versione dimostrativa l’area riservata non è collegata: registrazione, accesso e
          profilo funzionano nel portale vero, con la community attiva.
        </p>
      ) : (
        <NuovaPassword client:load />
      )
    }
  </AreaUtente>
</Base>
