---
import Base from '@/layouts/Base.astro'
import ArticleListing from '@/components/ArticleListing.astro'
import { ARTICLES_PER_PAGE, getArticles, getTagBySlug } from '@/lib/payload'
import { absoluteUrl, breadcrumbJsonLd } from '@/lib/seo'
import { populatedList } from '@/lib/types'
import type { Tag } from '@/lib/types'

/** Listing per tag — RF-P-03. */

/*
 * Percorsi pregenerati: solo build statica dimostrativa — vedi lib/modalita.ts.
 *
 * I tag si ricavano dagli articoli invece che da una query dedicata: sono per
 * definizione quelli in uso, e non serve aggiungere al client di produzione una
 * funzione che esiste solo per la dimostrazione.
 */
export async function getStaticPaths() {
  const { docs } = await getArticles({ limit: 500 })
  const slugs = new Set<string>()
  for (const a of docs) {
    for (const t of populatedList<Tag>(a.tags)) slugs.add(t.slug)
  }
  return [...slugs].map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const tag = slug ? await getTagBySlug(slug) : null
if (!tag) return Astro.rewrite('/404')

const pagina = Math.max(1, Number(Astro.url.searchParams.get('pagina') ?? '1') || 1)
const risultati = await getArticles({ tagSlug: tag.slug, page: pagina, limit: ARTICLES_PER_PAGE })

if (pagina > 1 && risultati.docs.length === 0) return Astro.rewrite('/404')

const base = `/tag/${tag.slug}`
const titoloSeo = pagina > 1 ? `${tag.name} — pagina ${pagina}` : tag.name
---

<Base
  title={titoloSeo}
  description={tag.description ?? `Tutti gli articoli su ${tag.name}.`}
  canonical={absoluteUrl(pagina > 1 ? `${base}?pagina=${pagina}` : base)}
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', url: '/' }, { name: tag.name, url: base }])]}
>
  <ArticleListing
    eyebrow="Argomento"
    titolo={tag.name}
    descrizione={tag.description}
    risultati={risultati}
    base={base}
    messaggioVuoto="Non ci sono ancora articoli con questo argomento."
  />
</Base>
