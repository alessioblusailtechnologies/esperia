---
import Base from '@/layouts/Base.astro'
import AreaUtente from '@/components/AreaUtente.astro'
import RecuperoPassword from '@/components/islands/account/RecuperoPassword.tsx'
import { MOCK } from '@/lib/modalita'

/**
 * Richiesta del link di reimpostazione della password — RF-C-01.
 */
---

<Base title="Recupera la password" description="Recupero della password dell’area riservata." noIndex>
  <AreaUtente
    titolo="Recupera la password"
    sottotitolo="Indica l’email del tuo account: ti invieremo un link per sceglierne una nuova."
  >
    {
      MOCK ? (
        <p class="riquadro">
          Nella versione dimostrativa l’area riservata non è collegata: registrazione, accesso e
          profilo funzionano nel portale vero, con la community attiva.
        </p>
      ) : (
        <RecuperoPassword client:load />
      )
    }
  </AreaUtente>
</Base>
