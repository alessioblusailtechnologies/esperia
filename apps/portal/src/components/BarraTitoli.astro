---
import type { Article, Category } from '@/lib/types'
import { populated } from '@/lib/types'

interface Props {
  titoli: Article[]
  /** Pastiglia fissa a sinistra: resta ferma mentre i titoli scorrono. */
  etichetta: string
  /**
   * Testo non cliccabile messo in testa alla sequenza. Nella versione
   * dimostrativa serve a ripetere, a ogni giro, che gli articoli sono inventati.
   */
  avviso?: string | null
}

const { titoli, etichetta, avviso = null } = Astro.props

/*
 * Le voci si preparano qui e non nel template: un `populated<Category>(...)`
 * dentro il markup verrebbe letto come un tag JSX di nome Category, e la
 * pagina si costruisce lo stesso ma `astro check` si ferma.
 */
const voci = titoli.map((a) => ({
  href: `/${a.slug}`,
  titolo: a.title,
  sezione: populated<Category>(a.category)?.name ?? null,
}))

/*
 * Barra dei titoli del momento.
 *
 * SCORRIMENTO SENZA JAVASCRIPT. L'animazione e' CSS: la sequenza e' scritta due
 * volte affiancate e la pista trasla di meta', cosi' il ritorno a capo non si
 * vede. La seconda copia e' aria-hidden, altrimenti uno screen reader
 * leggerebbe ogni titolo due volte.
 *
 * ACCESSIBILITA'. Contenuto che si muove da solo e' un problema noto (WCAG
 * 2.2.2): qui si ferma al passaggio del mouse e quando un elemento riceve il
 * fuoco da tastiera, e con prefers-reduced-motion non parte affatto — in quel
 * caso la barra resta scorrevole a mano. RNF-07.
 */
---

{
  titoli.length > 0 && (
    <div class="barra-titoli">
      <span class="barra-titoli__etichetta">{etichetta}</span>

      <div class="barra-titoli__pista">
        {[false, true].map((copia) => (
          <ul class="barra-titoli__sequenza" aria-hidden={copia ? 'true' : undefined}>
            {avviso && (
              <li class="barra-titoli__avviso">{avviso}</li>
            )}
            {voci.map((v) => (
              <li>
                <a href={v.href}>
                  {v.sezione && <span class="barra-titoli__sezione">{v.sezione}</span>}
                  {v.titolo}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  )
}

<style>
  .barra-titoli {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--colore-evidenza);
    border-bottom: 1px solid var(--colore-bordo-forte);
    padding-inline: var(--padding-laterale);
    /* Nasconde la sequenza che entra ed esce dai due lati. */
    overflow: hidden;
  }

  .barra-titoli__etichetta {
    flex-shrink: 0;
    padding: 9px 0;
    font-family: var(--font-testo);
    font-size: 11px;
    font-weight: var(--peso-forte);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--colore-accento);
    white-space: nowrap;
  }

  /* Filo verticale fra pastiglia e titoli. */
  .barra-titoli__etichetta::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 11px;
    margin-left: 14px;
    vertical-align: -1px;
    background: var(--colore-bordo-forte);
  }

  .barra-titoli__pista {
    display: flex;
    min-width: 0;
    overflow: hidden;
  }

  .barra-titoli__sequenza {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 9px 15px 9px 0;
    white-space: nowrap;
  }

  .barra-titoli__sequenza li {
    font-size: 13px;
    line-height: 1.3;
  }

  /* Pallino di separazione: sta sull'elemento, non fra i due elenchi, cosi'
     resta anche al punto di giunzione fra le due copie. */
  .barra-titoli__sequenza li + li::before,
  .barra-titoli__sequenza::after {
    content: '·';
    color: var(--colore-testo-meta);
    margin-right: 30px;
  }

  .barra-titoli__sequenza li + li::before {
    margin-right: 0;
    margin-left: -18px;
    padding-right: 18px;
  }

  .barra-titoli__sequenza a {
    color: var(--colore-testo);
    font-weight: var(--peso-medio);
  }

  .barra-titoli__sequenza a:hover {
    color: var(--colore-accento);
  }

  .barra-titoli__sezione {
    margin-right: 8px;
    font-size: 10px;
    font-weight: var(--peso-forte);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colore-testo-meta);
  }

  .barra-titoli__avviso {
    font-weight: var(--peso-medio);
    color: var(--colore-accento-scuro);
  }

  @media (prefers-reduced-motion: no-preference) {
    .barra-titoli__sequenza {
      animation: scorri-titoli 55s linear infinite;
    }

    /* Fermare la corsa e' un requisito, non una cortesia: WCAG 2.2.2. */
    .barra-titoli:hover .barra-titoli__sequenza,
    .barra-titoli:focus-within .barra-titoli__sequenza {
      animation-play-state: paused;
    }
  }

  /*
   * Senza animazione la seconda copia non serve a nulla e raddoppierebbe la
   * riga: si toglie, e la barra si scorre a mano.
   */
  @media (prefers-reduced-motion: reduce) {
    .barra-titoli__pista {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .barra-titoli__pista::-webkit-scrollbar {
      display: none;
    }

    .barra-titoli__sequenza[aria-hidden='true'] {
      display: none;
    }
  }

  @keyframes scorri-titoli {
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 760px) {
    .barra-titoli__etichetta {
      font-size: 10px;
    }

    .barra-titoli__sequenza {
      gap: 22px;
    }

    .barra-titoli__sequenza li + li::before {
      margin-left: -14px;
      padding-right: 14px;
    }
  }
</style>
